{
  "name": "rcode",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "PORTLESS_PORT=1355 concurrently \"portless run --name rcode vite\" \"agentation-mcp server\" --names \"vite,agentation\" --prefix-colors \"cyan,magenta\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "jazz:validate": "pnpm --filter @rcode/schema jazz:validate",
    "jazz:deploy": "set -a && source .env && set +a && pnpm --filter @rcode/schema jazz:deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@fontsource/commit-mono": "5.2.5",
    "@monaco-editor/react": "^4.7.0",
    "@rcode/icons": "workspace:*",
    "@rcode/schema": "workspace:*",
    "@rcode/ui": "workspace:*",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/monaco": "^4.2.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "better-auth": "catalog:",
    "jazz-tools": "catalog:",
    "lucide-react": "catalog:",
    "monaco-editor": "^0.55.1",
    "nanoid": "catalog:",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "^4.2.0",
    "sonner": "catalog:",
    "unique-names-generator": "^4.7.1",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "concurrently": "^9.2.1",
    "portless": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
