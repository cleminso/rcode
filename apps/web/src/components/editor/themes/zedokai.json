    "editorBracketMatch.border": "#00000000"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#fcfcfa"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#727072",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comment",
      "scope": ["comment.block.documentation", "comment.doc"],
      "settings": {
        "foreground": "#727072",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "identifier", "support.variable"],
      "settings": {
        "foreground": "#fcfcfa"
      }
    },
    {
      "name": "Special Variable",
      "scope": ["variable.language", "variable.other.special"],
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.variable.property", "meta.property-name"],
      "settings": {
        "foreground": "#fcfcfa"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "meta.tag"],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "String Regex",
      "scope": ["string.regexp", "string.regex"],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#fcfcfa"
      }
    },
    {
      "name": "String Special",
      "scope": ["string.interpolated", "string.special", "string.special.symbol"],
      "settings": {
        "foreground": "#fc9867"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "name": "Constant",
      "scope": ["constant"],
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#a9dc76"
      }
    },
    {
      "name": "Constructor",
      "scope": ["entity.name.function.constructor", "support.function.constructor", "keyword.operator.new"],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Label",
      "scope": ["entity.name.label"],
      "settings": {
        "foreground": "#a9dc76"
      }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "support.type", "entity.name.class", "support.class", "entity.name.namespace"],
      "settings": {
        "foreground": "#78dce8"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.string"],
      "settings": {
        "foreground": "#78dce8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "markup.deleted.git_gutter"],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.definition.tag", "punctuation.definition.string", "punctuation.definition.parameters", "punctuation.definition.array"],
      "settings": {
        "foreground": "#939293"
      }
    },
    {
      "name": "Punctuation Bracket",
      "scope": ["punctuation.section.brackets", "punctuation.section.embedded", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#939293"
      }
    },
    {
      "name": "Punctuation Delimiter",
      "scope": ["punctuation.separator.delimiter", "punctuation.separator.comma", "punctuation.separator.list"],
      "settings": {
        "foreground": "#939293"
      }
    },
    {
      "name": "Preproc",
      "scope": ["meta.preprocessor", "meta.preprocessor.string"],
      "settings": {
        "foreground": "#ab9df2"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#fcfcfa",
        "background": "#ff6188"
      }
    },
    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#a9dc76"
      }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Diff Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "Diff Header",
      "scope": ["meta.diff", "meta.diff.header"],
      "settings": {
        "foreground": "#727072"
      }
    },
    {
      "name": "Emphasis",
      "scope": ["emphasis", "markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strong",
      "scope": ["strong", "markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Link",
      "scope": ["markup.underline.link", "markup.underline.link.image", "string.other.link.title", "string.other.link.description"],
      "settings": {
        "foreground": "#a9dc76"
      }
    },
    {
      "name": "Literal",
      "scope": ["text.literal", "markup.raw", "markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "Title",
      "scope": ["entity.name.section", "markup.heading", "markup.heading.setext"],
      "settings": {
        "foreground": "#ffd866",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Code",
      "scope": ["meta.code", "meta.code.block"],
      "settings": {
        "foreground": "#fcfcfa"
      }
    },
    {
      "name": "Quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#727072",
        "fontStyle": "italic"
      }
    },
    {
      "name": "List",
      "scope": ["markup.list"],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "Info Token",
      "scope": ["token.info-token"],
      "settings": {
        "foreground": "#ffd866"
      }
    },
    {
      "name": "Warn Token",
      "scope": ["token.warn-token"],
      "settings": {
        "foreground": "#fc9867"
      }
    },
    {
      "name": "Error Token",
      "scope": ["token.error-token"],
      "settings": {
        "foreground": "#ff6188"
      }
    },
    {
      "name": "Debug Token",
      "scope": ["token.debug-token"],
      "settings": {
        "foreground": "#78dce8"
      }
    }
  ],
  "semanticHighlighting": true
}
