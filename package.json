{
  "name": "rcode",
  "version": "0.0.1",
  "private": true,
  "description": "A web real-time collaborative code editor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/regardedev/rcode"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' --filter './packages/*' dev",
    "build": "pnpm -r build"
  },
  "author": "cleminso",
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@better-auth/infra": "^0.2.11"
  }
}
